{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/cron/payment-reminders",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/billing-cycle-reset",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/annual-renewals",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/trial-reminders",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/bank-reconciliation-reminders",
      "schedule": "30 13 * * *"
    }
  ]
}
